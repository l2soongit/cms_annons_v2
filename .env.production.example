# Шаблон .env для віртуального хостингу graj.club.
# Скопіюйте на сервер як .env і заповніть значення. Не комітьте справжній .env.

APP_NAME=graj.club
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://graj.club

APP_LOCALE=uk
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# На віртуальному хостингу немає Redis і постійних процесів:
# сесії, кеш і черги живуть у MySQL, черги розбирає cron (див. DEPLOY.md).
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

FILESYSTEM_DISK=public

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@graj.club"
MAIL_FROM_NAME="${APP_NAME}"

# Модератори й адміністратори зобов'язані мати 2FA
REQUIRE_STAFF_2FA=true

# Вхід через Google / Discord (redirect: https://graj.club/auth/<провайдер>/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Telegram-бот для сповіщень; вебхук: https://graj.club/api/telegram/webhook/<TELEGRAM_WEBHOOK_SECRET>
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Захист від ботів і VPN
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
IPQS_KEY=
